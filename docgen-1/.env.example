# Copy to .env and adjust before running: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=docgen
POSTGRES_USER=docgen
POSTGRES_PASSWORD=docgen
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
WEB_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# --- API externe (utilisée par le container Bruno et tout client externe) ---
# Clé attendue dans l'en-tête HTTP "X-API-Key" des requêtes vers /documents/api/...
API_KEY=dev-api-key

# Auto-created on first boot (only if it does not already exist)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
