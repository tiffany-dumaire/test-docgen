meta {
  name: 01 - Lister les modeles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/documents/api/templates/
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

docs {
  Renvoie la liste des modèles de documents (id, name, kind, is_generic).
  Utilisez un `id` renvoyé ici comme champ `template` de la requête de génération.
}
