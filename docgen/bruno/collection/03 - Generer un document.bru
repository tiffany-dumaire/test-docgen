meta {
  name: 03 - Generer un document
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/documents/api/generate/
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Content-Type: application/json
}

body:json {
  {
    "template": 1,
    "project": 1,
    "title": "Devis généré via API",
    "confidentiality": "confidential",
    "comment": "Généré via Bruno",
    "initials": "API",
    "data": {
      "params": {
        "total": "4 200 € HT"
      },
      "rows": [
        { "region": "Nord", "product": "Audit", "amount": 1200 },
        { "region": "Sud",  "product": "Audit", "amount": 900 },
        { "region": "Nord", "product": "Refonte", "amount": 2100 }
      ]
    }
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("lastDocumentId", res.getBody().document_id);
  }
}

docs {
  Crée un document à partir d'un modèle (`template`), le génère et renvoie
  `document_id`, `version`, `kind` et `download_url`.

  - `template` (obligatoire) : id d'un modèle (voir requête 01).
  - `project` (facultatif) : id d'un projet (voir requête 02).
  - `data.params` : variables injectées dans le document ({{ total }}, etc.).
  - `data.rows` : lignes pour les tableaux Excel / Word.

  Le script post-réponse mémorise `document_id` dans la variable
  d'environnement `lastDocumentId`, réutilisée par la requête 04.
}
