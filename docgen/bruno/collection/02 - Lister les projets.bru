meta {
  name: 02 - Lister les projets
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/documents/api/projects/
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

docs {
  Renvoie la liste des projets (id, name, client_name).
  Utilisez un `id` renvoyé ici comme champ `project` (facultatif) de la génération.
}
